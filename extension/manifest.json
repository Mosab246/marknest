{
  "manifest_version": 3,
  "name": "MarkNest Capture",
  "version": "0.2.0",
  "description": "Save pages and tweets to MarkNest locally",
  "permissions": ["activeTab", "tabs", "scripting", "contextMenus", "storage", "notifications"],
  "host_permissions": [
    "http://127.0.0.1:4763/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://*/*",
    "http://*/*"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to MarkNest",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["contentScript.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "save-to-marknest": {
      "suggested_key": {
        "default": "Ctrl+Shift+M",
        "mac": "Command+Shift+M"
      },
      "description": "Save current page to MarkNest"
    }
  }
}
